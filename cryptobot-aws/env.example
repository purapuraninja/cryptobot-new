# AI provider
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace_me
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Execution safety
EXCHANGE_MODE=CEX
DRY_RUN=true

# Which CEX executes orders when EXCHANGE_MODE=CEX: bybit | okx
# Both stay "CEX", so the ROI-stop gate and RR sizing apply identically.
CEX_PROVIDER=bybit

BYBIT_API_KEY=replace_me
BYBIT_SECRET=replace_me
BYBIT_TESTNET=true

# OKX USDT-SWAP execution (only read when CEX_PROVIDER=okx).
# Credentials are the SAME trio as the OKX Web3 feed below — one OKX API key
# serves both REST v5 trading and data. Passphrase is mandatory (unlike Bybit).
# OKX_DEMO=true uses the x-simulated-trading header on the production host;
# there is no separate testnet domain.
OKX_DEMO=true
OKX_BASE_URL=https://www.okx.com
# Must match your OKX account margin mode: isolated | cross
OKX_MARGIN_MODE=isolated

HL_WALLET_ADDRESS=0xYourWalletAddress
HL_PRIVATE_KEY=0xYourPrivateKey
HL_TESTNET=true

# Paper/live cost assumptions (percentage units; 0.055 = 5.5 bps)
DRY_RUN_INCLUDE_COSTS=true
TAKER_FEE_PCT=0.055
DRY_RUN_SLIPPAGE_PCT=0.02

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Market universe and mode
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT
ACCOUNT_BALANCE=10000
TRADING_MODE=intraday
STRATEGY_VERSION=lifecycle-cost-v1-20260714
SCAN_INTERVAL_SECONDS=300
MAX_OPEN_POSITIONS=3
AUTO_SYMBOLS=true
AUTO_SYMBOLS_COUNT=30

# Position and leverage limits
MIN_POSITION_SIZE_PCT=0.1
MAX_POSITION_SIZE_PCT=3.0
LEVERAGE_FLOOR=1
LEVERAGE_CAP_DEFENSIVE=5
LEVERAGE_CAP_CONSERVATIVE=8
LEVERAGE_CAP_NORMAL=10
LEVERAGE_CAP_AGGRESSIVE=10
LEVERAGE_CAP_HIGH_RISK=5
MAX_LOSS_USDT_PER_TRADE=10.0
MAX_RISK_PCT_PER_TRADE=0.5

# Entry quality gates and evidence-based sizing
MIN_RR=1.5
MIN_SCORE_HARD=7.0
MIN_CONFIDENCE_HARD=0.70
MIN_SL_DISTANCE_PCT=0.40
EXPECTANCY_FILTER_ENABLED=true
BLOCK_HIGH_RISK_TRADES=true
HIGH_CONVICTION_ENABLED=false
AI_LEARNING=false
MEMORY_SYMBOL_SIZING_ENABLED=false
SCORE_85_95_MEDIUM_SIZE_MULT=1.0
SCORE_HIGH_THRESHOLD=9.0
SCORE_HIGH_SIZE_MULT=0.75
SHORT_DOWNTREND_SIZE_MULT=1.0
LONG_SIDEWAYS_SIZE_MULT=1.0
REJECT_FALLING_VOLUME_ENTRIES=true
LATE_CHASE_SIZE_MULT=0.25
SMC_FILTER_MODE=soft
SMC_HARD_REJECT_LATE_CHASE=false

# Stops, partial exits, and re-entry controls
SL_MODE=atr
DCA_ENABLED=false
PARTIAL_CLOSE_ENABLED=true
TP1_CLOSE_PCT=15.0
# TP2 is percent of the position remaining after TP1.
TP2_CLOSE_PCT=24.0
EXCHANGE_TP_ORDERS_ENABLED=false
REPEATED_LOSS_STREAK=2
REPEATED_LOSS_COOLDOWN_H=72.0

# Trailing take-profit: TP3 arms a moving target instead of closing.
# false restores the old fixed-price TP3 full close.
TRAILING_TP_ENABLED=true
# Exit when price gives back this much from the peak (N x ATR%, then clamped).
TRAILING_TP_GIVEBACK_ATR_MULT=1.5
TRAILING_TP_MIN_GIVEBACK_PCT=0.60
TRAILING_TP_MAX_GIVEBACK_PCT=5.0
# Next target sits this far beyond the peak (informational + extension basis).
TRAILING_TP_STEP_ATR_MULT=1.0
# Stop chasing and bank the trade once price runs N x initial risk past TP3.
TRAILING_TP_MAX_EXTENSION_R=4.0
# Close a profitable runner that goes this long without a new peak.
# Time-exit only ever touches losing positions, so this is its only guard.
TRAILING_TP_STALL_HOURS=8.0

# Storage
STORAGE_BACKEND=sqlite

# Optional OKX Web3 enrichment (data only; no order execution)
OKX_WEB3_ENABLED=false
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROJECT_ID=
OKX_WEB3_DEFAULT_CHAIN=501
OKX_WEB3_TOKEN_MAP=
OKX_WEB3_AUTO_RESOLVE=false
OKX_WEB3_RESOLVE_MIN_LIQUIDITY_USD=100000
OKX_WEB3_MAX_SYMBOLS=30
OKX_WEB3_CACHE_TTL_SECONDS=300
OKX_WEB3_TIMEOUT_SECONDS=10
OKX_WEB3_MIN_INTERVAL_MS=250
OKX_WEB3_429_MAX_RETRIES=2
OKX_WEB3_429_BASE_DELAY_MS=1000
ONCHAIN_CONTEXT_MAX_SYMBOLS=0
